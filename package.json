{
  "name": "frame-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:characters": "node scripts/check-character-assets.mjs",
    "check:characters:offline": "node scripts/bundle-mobile.mjs && node scripts/check-offline-characters.mjs",
    "review:animations": "node scripts/preview-animations.mjs",
    "check:gameplay": "node scripts/check-gameplay-ui.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:practice": "node scripts/check-camera-practice.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:native": "node scripts/check-native-services.mjs",
    "check:mobile": "node scripts/check-mobile-ui.mjs",
    "check:gyro": "node scripts/check-gyroscope.mjs",
    "check:career": "node scripts/check-career.mjs",
    "check:clips": "node scripts/check-clip-replay.mjs",
    "sim:career": "node scripts/sim-career.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:difficulty": "node scripts/check-difficulty.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
